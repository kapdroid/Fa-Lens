{
  "permissions": {
    "defaultMode": "plan",
    "deny": [
      "Bash(git push * main)",
      "Bash(git push --force *)",
      "Read(./.env.local)",
      "Read(./**/.env.local)"
    ]
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "bash", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.sh"] } ] }
    ],
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [ { "type": "command", "command": "bash", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-bash.sh"] } ] }
    ],
    "PostToolUse": [
      { "matcher": "Edit|Write", "hooks": [ { "type": "command", "command": "bash", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/post-edit.sh"] } ] }
    ]
  }
}
