  "typography": {
    "family": {
      "display": {
        "value": "'Bricolage Grotesque', 'Segoe UI', system-ui, sans-serif",
        "google": "Bricolage+Grotesque:opsz,wght@12..96,500..800",
        "use": "page titles, big verdict numbers, empty-state headlines. Restraint: max 2 per screen."
      },
      "ui": {
        "value": "'Plus Jakarta Sans', 'Segoe UI', system-ui, sans-serif",
        "google": "Plus+Jakarta+Sans:wght@400;500;600;700",
        "use": "everything else. Chosen for readability: open counters, generous x-height."
      },
      "mono": {
        "value": "'JetBrains Mono', 'SF Mono', Menlo, Consolas, monospace",
        "google": "JetBrains+Mono:wght@400;500;600",
        "use": "ids, counts, timestamps, paths, code, JSON. Any digit that lines up in a column."
      }
    },
