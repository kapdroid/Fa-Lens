== fa_txn ==
  fa_txn:
    kind: sql
    dialect: mssql
    database: FA_Transactions
    replica: true
    credential: vault://fa-txn-readonly
    scope:
      company: CompanyId
      date: CreatedAt
    limits:
      rows: 50000
      timeoutMs: 30000
      concurrency: 4
      interactiveMaxDays: 31
    servers:
      general: transaction-db
      mars: mars-transaction-db
      colpal: colpal-transaction-db
      haldiram: haldiram-transaction-db
      slmg: slmg-transaction-db
      bdf: bdf-transaction-db

